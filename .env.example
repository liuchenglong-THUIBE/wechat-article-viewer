# 微信公众号阅读器环境变量配置

# LLM 提供者配置 (openrouter, direct, mock)
WECHAT_READER_LLM_PROVIDER=openrouter

# LLM API 配置
WECHAT_READER_LLM_API_KEY=your-api-key-here
WECHAT_READER_LLM_MODEL=minimax/minimax-m2.5:free
WECHAT_READER_LLM_BASE_URL=https://openrouter.ai/api/v1

# OpenRouter 排名标识（可选）
WECHAT_READER_LLM_SITE_URL=
WECHAT_READER_LLM_SITE_NAME=

# 路径配置
# 注意：程序会自动把 API 数据写入 frontend/api，因此这里填写前端根目录 frontend。
WECHAT_READER_FRONTEND_DIR=frontend

# Git 配置
WECHAT_READER_AUTO_GIT_PUSH=true

# 导出配置
WECHAT_READER_EXPORT_MAX_ARTICLES=1000
WECHAT_READER_EXPORT_SUMMARY_ONLY=false

# 日志级别
WECHAT_READER_LOG_LEVEL=INFO
